# Copy to .env:  cp .env.example .env
# Everything here is an EXAMPLE value for LOCAL DEVELOPMENT ONLY. Never use these credentials
# anywhere reachable from the internet, never commit .env, and put real secrets only in your
# own untracked .env or your server's secret store.
APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://outfitmaxing:change-me@localhost:5432/outfitmaxing
REDIS_URL=redis://localhost:6379/0
RESERVATION_TTL_MINUTES=15

# Key for catalog write endpoints (interim until Phase 6 login/roles). Min 16 chars.
# Termux setup.sh generates one for you. Empty = admin endpoints disabled (fail closed).
ADMIN_API_KEY=

# AI (provider abstraction; Gemini free tier initially). Phase 4.
AI_PROVIDER=gemini
AI_MODEL=
AI_API_KEY=
AI_DAILY_REQUEST_LIMIT=
AI_PER_USER_HOURLY_LIMIT=

# Telegram. Phase 4.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHANNEL_ID=
TELEGRAM_WEBHOOK_URL=

# Business policies: PENDING final business approval. Leave unset until approved.
# Owner's PROPOSALS (not defaults, not enforced until set):
# POLICY_CANCELLATION_RULE=before_dispatch
# POLICY_RETURN_WINDOW_DAYS=3
# POLICY_REFUND_AFTER_INSPECTION=true
# POLICY_PREORDER_DEPOSIT_PERCENT=30
# POLICY_COD_MAX_ORDER_MMK=
# POLICY_COD_MANUAL_REVIEW_ABOVE_MMK=
POLICIES_APPROVED_FOR_LAUNCH=false
